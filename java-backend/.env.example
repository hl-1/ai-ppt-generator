# 可与 backend/.env 使用同一套值。Java 会把 postgresql+asyncpg:// 转成 JDBC。
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://aippt:aippt@localhost:39432/aippt
REDIS_URL=redis://localhost:39379/0

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=60

IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_WORKSPACE_ID=
IMAGE_TIMEOUT_SECONDS=60
UNSPLASH_ACCESS_KEY=
MAX_IMAGE_MB=8

CORS_ORIGINS=["http://localhost:39173","http://127.0.0.1:39173"]

JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
MAX_UPLOAD_MB=10

SERVER_PORT=39800
