  {
    "plan": {
      "title": "刻意练习：走出舒适区的具体方法",
      "layout_id": "bullets",
      "objective": "让听众掌握刻意练习的核心要素，并能设计自己的练习计划",
      "page_role": "content",
      "key_points": [
        "刻意练习三要素：明确的小目标、略高于现有水平的难度、即时反馈；三者缺一容易退化为机械重复",
        "拆解练习单元示例：把'提升系统设计能力'拆为每周完成一个模块的设计文档并自我评审（示例做法，可按岗位调整）",
        "针对弱点专项练：把评审中被指出的高频问题整理成专项清单，逐项安排针对性练习而非泛泛刷题",
        "间隔与记录：分散安排练习频率并记录练习日志，便于回看进步轨迹与调整难度"
      ],
      "key_message": "有目标、有反馈、有难度的重复才能带来能力增长，低水平重复无效",
      "visual_type": "auto",
      "evidence_kind": "narrative",
      "narrative_role": "driver"
    },
    "slide": {
      "id": "format-case-3",
      "layout_id": "bullets",
      "blocks": [
        {
          "id": "case-3-kicker",
          "slot_id": "case-3-kicker",
          "locked": false,
          "style": null,
