[
  {
    "plan": {
      "title": "资源与时间：把学习纳入工作节奏",
      "layout_id": "table",
      "objective": "让听众学会筛选学习资源并规划可持续的投入方式",
      "page_role": "content",
      "key_points": [
        "资源分层建议：文档与官方手册用于查证、系统课程用于补基础、源码与实战项目用于深化，避免收藏代替学习",
        "筛选原则：优先与当前工作目标直接相关的资源，学完即用的内容留存率远高于储备式学习",
        "时间安排示例：建议每天固定 30–60 分钟或每周半天用于技术学习，嵌入日程而非依赖空闲（建议值，可按个人节奏调整）",
        "利用工作制度：善用团队内的技术分享时间、内部培训与复盘会议，把组织资源转化为个人学习机会"
      ],
      "key_message": "资源贵在精不在多，关键是把固定的小块时间持续投入工作相关学习",
      "visual_type": "auto",
      "evidence_kind": "table",
      "narrative_role": "supporting"
    },
