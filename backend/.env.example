# 运行环境：development / production 等
APP_ENV=development

# 异步 PostgreSQL 连接串（宿主机端口 39432，对应 docker-compose 映射）
DATABASE_URL=postgresql+asyncpg://aippt:aippt@localhost:39432/aippt

# Redis 连接串（宿主机端口 39379，对应 docker-compose 映射）
REDIS_URL=redis://localhost:39379/0

# 允许跨域的前端源列表（JSON 数组）
CORS_ORIGINS=["http://localhost:39173"]

# JWT 签名密钥（HS256）。生产环境必须替换，可用：openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# JWT 签名算法
JWT_ALGORITHM=HS256

# access token 过期时间（分钟），默认 7 天；本项目不做 refresh token
JWT_EXPIRE_MINUTES=10080

# 对象存储驱动：local 落盘到 backend/var/storage，cos 走腾讯云
# 选 cos 需额外安装 SDK：uv add cos-python-sdk-v5
STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# 单个上传文件的体积上限（MB）
MAX_UPLOAD_MB=10
